# Review and move to .github/workflows only after approving a public repo.
name: local-equivalent-checks
on: [push, pull_request]
permissions:
  contents: read
jobs:
  checks:
    if: github.event.repository.private == false
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 24
      - run: npm ci
      - run: npm run setup && npm run db:deploy
      - run: npm run typecheck && npm run lint && npm test && npm run build
      - run: npm audit --audit-level=high
# No cache/artifact uploads and no larger runners. Not enabled in this pre-release.

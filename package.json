{
  "name": "railway-cost-observer",
  "version": "0.2.0-rc.1",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:deploy": "node scripts/migrate.mjs",
    "setup": "node scripts/setup.mjs",
    "worker": "node --env-file=.env --import tsx src/worker.ts",
    "mcp": "tsx src/mcp.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@prisma/client": "6.12.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "nodemailer": "10.6.1",
    "prisma": "6.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "^4.20.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.6",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "type": "module",
  "license": "MIT"
}

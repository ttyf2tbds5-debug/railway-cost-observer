{
  "openapi": "3.1.0",
  "info": {
    "title": "Cost Observer API",
    "version": "0.2.0-rc.1",
    "description": "Pre-release. Read-only Railway integration. Budget writes are local advisory configuration, never Railway spend limits."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    },
    {
      "sessionCookie": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "costobserver_session"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string"
              }
            }
          }
        }
      },
      "Budget": {
        "type": "object",
        "required": [
          "budget"
        ],
        "additionalProperties": false,
        "properties": {
          "budget": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0,
            "maximum": 1000000
          }
        }
      },
      "ConnectionInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "workspaceId",
          "token"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "token": {
            "type": "string",
            "minLength": 20,
            "maxLength": 2048,
            "writeOnly": true
          }
        }
      },
      "Snapshot": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "projectId": {
            "type": "string"
          },
          "metrics": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "periodStart": {
            "type": "string",
            "format": "date-time"
          },
          "periodEnd": {
            "type": "string",
            "format": "date-time"
          },
          "cost": {
            "type": "number"
          },
          "forecast": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "projectId",
          "metrics",
          "createdAt",
          "periodStart",
          "periodEnd",
          "cost",
          "forecast"
        ]
      },
      "Connection": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          },
          "lastSync": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "lastError": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "workspaceId",
          "lastSync",
          "lastError"
        ]
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "connectionId": {
            "type": "string"
          },
          "budget": {
            "type": [
              "number",
              "null"
            ]
          },
          "snapshots": {
            "type": "array",
            "maxItems": 96,
            "items": {
              "$ref": "#/components/schemas/Snapshot"
            }
          },
          "alertsEnabled": {
            "type": "boolean"
          },
          "forecastAlerts": {
            "type": "boolean"
          },
          "anomalyMultiplier": {
            "type": "number",
            "minimum": 1.5,
            "maximum": 20
          },
          "insights": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "code",
                "message",
                "evidence",
                "automaticAction"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "serviceId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "message": {
                  "type": "string"
                },
                "evidence": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number"
                  }
                },
                "automaticAction": {
                  "const": false
                }
              }
            }
          }
        },
        "required": [
          "id",
          "name",
          "connectionId",
          "budget",
          "snapshots"
        ]
      },
      "Audit": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "action",
          "subject",
          "createdAt"
        ]
      },
      "Alert": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "projectId": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "dedupeKey": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "acknowledgedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "deliveredAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "deliveryAttempts": {
            "type": "integer"
          },
          "nextAttemptAt": {
            "type": "string",
            "format": "date-time"
          },
          "project": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ]
          },
          "deliveries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "channel": {
                  "enum": [
                    "webhook",
                    "discord",
                    "telegram",
                    "email"
                  ]
                },
                "attempts": {
                  "type": "integer"
                },
                "deliveredAt": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "lastError": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "required": [
          "id",
          "projectId",
          "kind",
          "message",
          "project",
          "createdAt",
          "acknowledgedAt",
          "deliveryAttempts",
          "nextAttemptAt",
          "deliveredAt"
        ]
      },
      "Dashboard": {
        "type": "object",
        "properties": {
          "connections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Connection"
            }
          },
          "projects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Project"
            }
          },
          "alerts": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Alert"
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "currency": {
                "const": "USD"
              },
              "estimateOnly": {
                "const": true
              },
              "pricingAsOf": {
                "type": "string"
              },
              "forecastMethod": {
                "const": "linear-billing-period"
              },
              "automaticInterventions": {
                "const": false
              },
              "retentionDays": {
                "type": "integer"
              }
            },
            "required": [
              "currency",
              "estimateOnly",
              "pricingAsOf",
              "forecastMethod",
              "automaticInterventions",
              "retentionDays"
            ]
          }
        },
        "required": [
          "connections",
          "projects",
          "alerts",
          "meta"
        ]
      },
      "Policy": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alertsEnabled",
          "forecastAlerts",
          "anomalyMultiplier"
        ],
        "properties": {
          "alertsEnabled": {
            "type": "boolean"
          },
          "forecastAlerts": {
            "type": "boolean"
          },
          "anomalyMultiplier": {
            "type": "number",
            "minimum": 1.5,
            "maximum": 20
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/dashboard": {
      "get": {
        "operationId": "get__api_v1_dashboard",
        "summary": "Read usage estimates, history, budgets and alerts",
